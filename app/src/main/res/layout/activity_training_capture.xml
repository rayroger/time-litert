<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <!-- Live camera view: the whole field of view (fit, not cropped) so what you see is what is captured. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/trainingPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fitCenter" />

    <!-- Boxes + numbers for every watch the detector currently sees (numbered like dial_index). -->
    <com.yourname.watchreader.LiveOverlayView
        android:id="@+id/liveOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Status chips, always visible. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/liveStatusText"
            style="@style/StatusChip"
            android:text="@string/live_starting"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/trainingStatusText"
            style="@style/StatusChip"
            android:text="@string/training_status_idle" />

        <TextView
            android:id="@+id/uploadStatusText"
            style="@style/StatusChip"
            android:text="@string/upload_status_disabled" />

        <TextView
            android:id="@+id/serverStatusText"
            style="@style/StatusChip"
            android:text="@string/server_status_stopped"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Settings: hidden until the gear button is tapped. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/settingsPanel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F2FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interval_label"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/intervalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="15"
                android:textColor="#000000" />

            <Button
                android:id="@+id/uploadSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_upload_settings" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating controls. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:gravity="end"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/action_settings" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/serverToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/action_start_server" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/startButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/capture_start" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/stopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/capture_stop"
            android:visibility="gone"
            app:backgroundTint="#D32F2F" />
    </LinearLayout>
</FrameLayout>
